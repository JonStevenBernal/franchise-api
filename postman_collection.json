    {
      "name": "3. Productos",
      "item": [
        {
          "name": "3.1 Agregar Producto (Exitoso - 201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var data = pm.response.json();",
                  "    var sucursalIdActual = pm.collectionVariables.get('sucursalId');",
                  "    if (data.sucursales && data.sucursales.length > 0) {",
                  "        var sucursalEncontrada = data.sucursales.find(function (sucursal) {",
                  "            return sucursal.id === sucursalIdActual;",
                  "        });",
                  "        if (sucursalEncontrada && sucursalEncontrada.productos && sucursalEncontrada.productos.length > 0) {",
                  "            var ultimoProducto = sucursalEncontrada.productos[sucursalEncontrada.productos.length - 1];",
                  "            pm.collectionVariables.set('productoId', ultimoProducto.id);",
                  "        }",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Cafe Latte\",\n  \"stock\": 25\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/franquicias/{{franquiciaId}}/sucursales/{{sucursalId}}/productos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "franquicias", "{{franquiciaId}}", "sucursales", "{{sucursalId}}", "productos"]
            }
